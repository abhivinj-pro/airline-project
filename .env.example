# Azure OpenAI configuration (Entra ID authentication)
ENDPOINT_URL=https://datascienceopenai-actualeastus2.openai.azure.com/
DEPLOYMENT_NAME=gpt-4o
MODEL_NAME=gpt-4o
OPENAI_API_VERSION=2025-01-01-preview

# Development only: disable browser caching for HTML/static GET requests
# Set to 1 when you want every refresh to fetch fresh assets.
DISABLE_HTTP_CACHE=0
